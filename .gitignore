# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/

# local reference checkout only — 5 cloned legacy repos (each its own git
# repo) kept for migration reference, not part of this product. They're
# already public under github.com/ajiboladev; no need to duplicate them
# (and embedding nested .git dirs as gitlinks would be messy). Not this
# app's Next.js static-export /out/ either — this app doesn't use
# `output: "export"`, so there's no real name collision, just this one.
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
