// --- Question bank, foundation (Task 0032 slice 1; design note docs/development-history/forms-and-question-bank-design.md) ---
//
// Only the tables slices 1 and 2 need. Forms, practice and reports arrive with their own slices so each migration stays reviewable. No existing table is changed (the
// relation fields on Branch and User below produce no SQL).
//
// Not composite (branchId, id) like the rest of the schema, on purpose: a GENERAL item has `branchId = null` (it belongs to every branch), and a composite foreign key
// with a null column is not enforced. Children point at the item by its id alone; a route reads an item only after checking its branchId (or that it is general).

/// Which of the two banks an item lives in.
enum BankKind {
  ASSESSMENT
  QUESTIONNAIRE
}

/// Named BankQuestionType because the quiz already owns `QuestionType`.
enum BankQuestionType {
  SINGLE
  MULTI
  TRUE_FALSE
  SHORT
  RATING
  TEXT
}

/// Decided once, at approval, by someone senior ("a question may appear later, never disappear"). The default is the safest one: a row that nobody classified is never
/// shown to a pupil.
enum BankVisibility {
  PRACTICE
  TEACHERS_ONLY
  TEACHERS_ONLY_UNTIL
}

enum BankItemStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  RETIRED
}

enum BankReviewOutcome {
  APPROVED
  EDITED
  REJECTED
  RETIRED
}

enum BankReviewerScope {
  GENERAL
  SUBJECT
}

/// A reusable question. `branchId` null = general (every branch), set = that branch only. Class and subject tags are TEXT (a label as typed plus a key from
/// `normalizeLabel`), never foreign keys: ClassGroup and Subject rows belong to one branch (maintainer's decision of 2026-10-19, design note 16a).
model QuestionBankItem {
  id            String           @id @default(cuid())
  branchId      String?
  bank          BankKind         @default(ASSESSMENT)
  type          BankQuestionType
  prompt        String
  explanation   String?
  points        Int              @default(1)
  difficulty    Int?
  topic         String?
  options       Json             @default("[]")
  /// A string, or an array of strings for MULTI; null for questionnaire items. Never sent to a pupil before the question is answered.
  correctAnswer Json?
  subjectLabel  String?
  subjectKey    String?
  visibility    BankVisibility   @default(TEACHERS_ONLY)
  /// For TEACHERS_ONLY_UNTIL: the date from which pupils may see it (the "until an assessment closes" form arrives with slice 3).
  visibleFrom        DateTime?
  /// For TEACHERS_ONLY_UNTIL: the assessment whose close unlocks the item for pupils.
  visibleAfterQuizId String?
  status             BankItemStatus   @default(DRAFT)
  /// A fix creates a new version; old versions are kept.
  version            Int              @default(1)
  submittedById      String
  approvedById       String?
  approvedAt         DateTime?
  retiredReason      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt

  branch      Branch?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  submittedBy User                   @relation("BankItemSubmitter", fields: [submittedById], references: [id], onDelete: NoAction)
  approvedBy  User?                  @relation("BankItemApprover", fields: [approvedById], references: [id], onDelete: NoAction)
  images      QuestionBankImage[]
  classTags   QuestionBankClassTag[]
  reviews     QuestionBankReview[]
  versions    QuestionBankItemVersion[]
  flags       QuestionOverlapFlag[]  @relation("FlagItem")
  similarTo   QuestionOverlapFlag[]  @relation("FlagSimilarTo")
  practiceAttempts    PracticeAttempt[]
  reports             QuestionReport[]
  copiedFormQuestions FormQuestion[]

  @@index([branchId, status])
  @@index([status, visibility])
  @@index([bank, subjectKey])
  @@index([visibleAfterQuizId])
}

/// At most 4 per item (a trigger; the superadmin's setting, 3 or 4, is enforced by the service). Alt text is required unless the image is marked decorative (a check).
model QuestionBankImage {
  id          String   @id @default(cuid())
  itemId      String
  /// Unique: two rows can never point at one stored file.
  storageKey  String   @unique
  /// Which backend holds the file (`s3`, `r2`, `cloudinary` or `memory`; a check, kept equal to `STORE_NAMES` by a test). A row says where its own file is, so changing the
  /// configured store later does not orphan the images already saved.
  store       String
  /// What OUR record says the file is (`image/jpeg`, `image/png` or `image/webp`; a check). It is the type the image is served as: the store is never asked.
  contentType String
  alt         String   @default("")
  decorative  Boolean  @default(false)
  bytes       Int
  width       Int
  height      Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  item QuestionBankItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, sortOrder])
}

/// What the question looked like at one version ("a fix creates a new version, old versions are kept"). Written in the same transaction as the change; never updated or
/// deleted (a trigger), like the review and audit rows. The snapshot holds the whole question including its answer key, so it is read by staff only.
model QuestionBankItemVersion {
  id          String   @id @default(cuid())
  itemId      String
  version     Int
  snapshot    Json
  actorUserId String
  createdAt   DateTime @default(now())

  item  QuestionBankItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  actor User             @relation("BankVersionsWritten", fields: [actorUserId], references: [id], onDelete: NoAction)

  @@unique([itemId, version])
}

/// A class tag: the label as typed and its key. A branch's class matches when `normalizeLabel(ClassGroup.name)` equals `labelKey`.
model QuestionBankClassTag {
  id       String @id @default(cuid())
  itemId   String
  label    String
  labelKey String

  item QuestionBankItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, labelKey])
  @@index([labelKey])
}

/// Every decision on an item, immutable: UPDATE and DELETE are refused by a trigger.
model QuestionBankReview {
  id         String            @id @default(cuid())
  itemId     String
  version    Int
  reviewerId String
  outcome    BankReviewOutcome
  reason     String?
  createdAt  DateTime          @default(now())

  item     QuestionBankItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  reviewer User             @relation("BankReviewsGiven", fields: [reviewerId], references: [id], onDelete: NoAction)

  @@index([itemId, createdAt])
}

/// Who may review. `branchId` null = a reviewer for every branch (assigned by a superadmin); set = that branch's reviewer (assigned by its administrator). GENERAL covers
/// all subjects; SUBJECT names one (label as typed plus key). `isExamApprover` marks someone who sees overlap warnings and sets visibility. One row per person, branch,
/// scope and subject (a unique index in the migration, because the columns are nullable).
model QuestionBankReviewer {
  id             String            @id @default(cuid())
  userId         String
  branchId       String?
  scope          BankReviewerScope
  subjectLabel   String?
  subjectKey     String?
  isExamApprover Boolean           @default(false)
  assignedById   String
  createdAt      DateTime          @default(now())

  user       User    @relation("BankReviewerUser", fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedBy User    @relation("BankReviewerAssigner", fields: [assignedById], references: [id], onDelete: NoAction)

  @@index([userId])
  @@index([branchId, scope])
}

/// A silent similarity hit, visible to exam approvers only. `similarToAssessmentQuestionId` has no foreign key yet: the assessment questions it points at arrive with
/// slice 3.
model QuestionOverlapFlag {
  id                            String   @id @default(cuid())
  itemId                        String
  similarToItemId               String?
  similarToAssessmentQuestionId String?
  score                         Float
  createdAt                     DateTime @default(now())

  item      QuestionBankItem  @relation("FlagItem", fields: [itemId], references: [id], onDelete: Cascade)
  similarTo QuestionBankItem? @relation("FlagSimilarTo", fields: [similarToItemId], references: [id], onDelete: SetNull)

  @@index([itemId])
}

/// Append-only trail of every approval, rejection, retirement, visibility change, reviewer assignment and switch change: who, what, when, old and new value. UPDATE and
/// DELETE are refused by a trigger. `branchId` null = a school-wide change. `itemId` carries no foreign key on purpose (like ResultAudit): the trail outlives the row.
model QuestionBankAudit {
  id          String   @id @default(cuid())
  branchId    String?
  itemId      String?
  actorUserId String?
  /// What kind of thing changed: "ITEM", "REVIEWER" or "SETTING".
  entity      String
  action      String
  /// The setting key, or the reviewer row's id, when the entity is not an item.
  ref         String?
  oldValue    Json?
  newValue    Json?
  reason      String?
  createdAt   DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor  User?   @relation("BankAudits", fields: [actorUserId], references: [id], onDelete: NoAction)

  @@index([branchId, createdAt])
  @@index([itemId])
  @@index([createdAt])
}

// --- Pupil Practice (Task 0032 slice 4; design note docs/development-history/forms-and-question-bank-design.md §8.4) ---

enum PracticeFeedbackMode {
  EACH
  END
}

/// A pupil's practice set. Draws random approved PRACTICE items for the pupil's class. Never graded; private to the pupil.
model PracticeSession {
  id           String               @id @default(cuid())
  branchId     String
  studentId    String
  classGroupId String?
  subjectLabel String?
  subjectKey   String?
  topic        String?
  size         Int
  feedbackMode PracticeFeedbackMode @default(EACH)
  itemIds      Json                 @default("[]")
  startedAt    DateTime             @default(now())
  finishedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt

  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student  StudentRecord     @relation(fields: [branchId, studentId], references: [branchId, id], onDelete: Cascade)
  attempts PracticeAttempt[]

  @@unique([branchId, id])
  @@index([branchId, studentId])
  @@index([branchId, studentId, startedAt])
}

/// An answer given in a practice session. Kept for history; a pupil can archive entries (hidden from pupil's view, still feeds class summaries).
model PracticeAttempt {
  id         String    @id @default(cuid())
  sessionId  String
  branchId   String
  studentId  String
  bankItemId String
  version    Int
  answer     Json
  correct    Boolean
  answeredAt DateTime  @default(now())
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  branch   Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  session  PracticeSession  @relation(fields: [branchId, sessionId], references: [branchId, id], onDelete: Cascade)
  student  StudentRecord    @relation(fields: [branchId, studentId], references: [branchId, id], onDelete: Cascade)
  bankItem QuestionBankItem @relation(fields: [bankItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, id])
  @@index([branchId, sessionId])
  @@index([branchId, studentId])
  @@index([branchId, studentId, archivedAt])
  @@index([branchId, bankItemId])
}

// --- Question Reports (Task 0032 slice 5; design note §8.5) ---

enum QuestionReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum QuestionReportOutcome {
  FIXED
  NOT_AN_ERROR
  NEEDS_DISCUSSION
}

/// An issue reported on a question by a teacher or pupil ("report an issue", not a thread).
/// Reviewers see role and section only (NDPA privacy protection: pupil identities never shown).
model QuestionReport {
  id                String                 @id @default(cuid())
  branchId          String?
  itemId            String
  itemVersion       Int
  reporterRole      String                 // "TEACHER" | "PUPIL"
  reporterSection   String                 // e.g. "JSS", "SSS", or branch name
  reporterUserId    String?
  reporterStudentId String?
  reason            String
  status            QuestionReportStatus   @default(OPEN)
  outcome           QuestionReportOutcome?
  outcomeReason     String?
  resolvedById      String?
  resolvedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt

  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  item            QuestionBankItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reporterUser    User?            @relation("ReportTeacher", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reporterStudent StudentRecord?   @relation("ReportPupil", fields: [reporterStudentId], references: [id], onDelete: SetNull)
  resolvedBy      User?            @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([itemId, status])
  @@index([reporterUserId])
  @@index([reporterStudentId])
}

// --- Printing: Server PDFs, Windows, Watermark, Logs (Task 0032 slice 10; design note §7.7, §8.9, §11, §13.10) ---

enum PrintTargetKind {
  QUESTION_BANK_ITEM
  FORM
  QUIZ
  PRACTICE_SESSION
  FORM_RESPONSE
}

/// Audit log for server-generated PDF prints with watermarks.
/// Append-only: database trigger prevents updates or deletions.
model QuestionBankPrintLog {
  id                 String          @id @default(cuid())
  branchId           String
  userId             String?
  studentId          String?
  targetKind         PrintTargetKind
  targetId           String
  title              String
  watermark          String
  pageCount          Int             @default(1)
  reason             String?
  recipientStudentId String?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime        @default(now())

  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user             User?          @relation("PrintLogActor", fields: [userId], references: [id], onDelete: SetNull)
  student          StudentRecord? @relation("PrintLogStudent", fields: [branchId, studentId], references: [branchId, id], onDelete: Cascade)
  recipientStudent StudentRecord? @relation("PrintLogRecipient", fields: [branchId, recipientStudentId], references: [branchId, id], onDelete: SetNull)

  @@unique([branchId, id])
  @@index([branchId, targetKind, targetId])
  @@index([branchId, userId])
  @@index([branchId, studentId])
  @@index([branchId, recipientStudentId])
  @@index([branchId, createdAt])
}

