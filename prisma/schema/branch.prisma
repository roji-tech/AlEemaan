// --- School structure (PRD §3): one school, four branches ---

/// The four legacy sections, unified: Secondary (English), Primary (English),
/// Secondary (Arabic), Primary (Arabic) — seeded once, at setup. Nothing routes
/// on the `code` (unlike Octalve Edu's Tenant): it is the prefix of the branch's
/// invoice and receipt numbers.
model Branch {
  id                  String  @id @default(cuid())
  name                String  @unique
  /// 2-6 capital letters and digits, unique across the school, so `INV-<code>-2026-0001` never repeats between branches (the first four letters of the name did:
  /// Secondary (English) and Secondary (Arabic) are both SECO). The default is not a value: an insert that leaves it empty gets one made from the name by the
  /// `Branch_assign_code` trigger (migration 20261020120000_branch_code), so every way of creating a branch is covered. It does not change when the branch is renamed.
  code                String  @unique @default("")
  /// Student and parent sign-in for THIS branch (task 0091): two switches, OFF until an administrator of the branch (or a superadmin) turns them on. A person whose only active roles
  /// are STUDENT and/or PARENT signs in, and keeps a session, only through a membership in a branch whose matching switch is on (a STUDENT membership needs `studentLoginEnabled`,
  /// a PARENT membership `parentLoginEnabled`, of that very branch). Anyone with another active role, and any superadmin, is never affected.
  studentLoginEnabled Boolean @default(false)
  parentLoginEnabled  Boolean @default(false)
  /// Task 0113 (task 0094 D7): families of this branch may still sign in with the date of birth (pupil) or the guardian's full phone or e-mail, besides an access code. On until
  /// the branch's codes are out; an administrator turns it off on Settings > Sign-in access.
  legacyPortalSecrets Boolean @default(true)

  profile                BranchProfile?
  memberships            Membership[]
  invitations            Invitation[]
  sessions               AcademicSession[]
  periods                AcademicPeriod[]
  academicBreaks         AcademicBreak[]
  students               StudentRecord[]
  scholarshipTypes       ScholarshipType[]
  enrollments            StudentEnrollment[]
  attendanceRecords      AttendanceRecord[]
  classGroups            ClassGroup[]
  sections               Section[]
  resultApprovalScopes   ResultApprovalScope[]
  classArms              ClassArm[]
  subjects               Subject[]
  departments            Department[]
  departmentMembers      DepartmentMember[]
  subjectOfferings       SubjectOffering[]
  assessmentSchemes      AssessmentScheme[]
  staffRecords           StaffRecord[]
  staffAssignments       StaffSubjectAssignment[]
  results                Result[]
  resultAudits           ResultAudit[]
  reportRemarks          ReportRemark[]
  assessmentComps        AssessmentComponent[]
  gradeScales            GradeScale[]
  resultTemplates        ResultTemplate[]
  resultTemplateClasses  ResultTemplateClass[]
  gradeBands             GradeBand[]
  settingValues          SettingValue[]
  settingApprovals       SettingApproval[]
  settingAudits          SettingAudit[]
  schemeScopes           AssessmentSchemeScope[]
  schemeDrafts           AssessmentSchemeDraft[]
  selfApprovalGrants     AdminSelfApprovalGrant[]
  verificationConfig     VerificationPageConfig?
  attendanceGrants       AttendanceGrant[]
  timetableSlots         TimetableSlot[]
  announcements          Announcement[]
  feeStructures          FeeStructure[]
  invoices               Invoice[]
  payments               Payment[]
  invoiceDiscounts       InvoiceDiscount[]
  receiptCounters        ReceiptCounter[]
  invoiceCounters        InvoiceCounter[]
  assignments            Assignment[]
  submissions            AssignmentSubmission[]
  learningMaterials      LearningMaterial[]
  quizzes                Quiz[]
  quizQuestions          QuizQuestion[]
  quizAttempts           QuizAttempt[]
  notificationTemplates  NotificationTemplate[]
  notificationDispatches NotificationDispatch[]
  guardianLinkTokens     GuardianLinkToken[]
  notificationAuditLogs  NotificationAuditLog[]
  promotionBatches       PromotionBatch[]
  bankItems              QuestionBankItem[]
  bankReviewers          QuestionBankReviewer[]
  bankAudits             QuestionBankAudit[]
  practiceSessions       PracticeSession[]
  practiceAttempts       PracticeAttempt[]
  questionReports        QuestionReport[]
  forms                  Form[]
  formAudiences          FormAudience[]
  formQuestions          FormQuestion[]
  formResponses          FormResponse[]
  formAnswers            FormAnswer[]
  formParticipations     FormParticipation[]
  /// The program this branch was made for, when it has one of its own (task 0043).
  ownedProgram           Program?                 @relation("ProgramOwnBranch")
  programLinks           ProgramBranch[]          @relation("ProgramBranches")
  formTurnIns            FormTurnIn[]
  formTurnInAudits       FormTurnInAudit[]
  formMarkingAudits      FormMarkingAudit[]
  questionBankPrintLogs  QuestionBankPrintLog[]

  createdAt                 DateTime                   @default(now())
  resultTemplateTraitGroups ResultTemplateTraitGroup[]
  resultTemplateTraits      ResultTemplateTrait[]
  traitRatings              TraitRating[]
  reportAttendance          ReportAttendance[]
  classGradeScales          ClassGradeScale[]
}

enum Role {
  ADMIN
  TEACHING_STAFF
  NON_TEACHING_STAFF
  STUDENT
  PARENT
}

/// Same fixed, deliberately small permission set as Octalve Edu (shared
/// design — see octalve-edu's domain-implementation-plan.md §1.7). ADMIN
/// implicitly has every permission; this only grants a non-admin extra
/// capability without making them a full admin.
enum Permission {
  CAN_APPROVE_RESULTS
  CAN_MANAGE_FINANCE
  CAN_PUBLISH_CONTENT
  CAN_MANAGE_USERS
  CAN_VIEW_FORM_RESULTS
}

/// A person's standing in the school. Every membership is branch-scoped,
/// including ADMIN's — an admin's own membership row anchors to one branch
/// (whichever the setup wizard or an invite assigned), but the ADMIN role
/// itself is authorized across every branch at the application layer via
/// withAuth(handler, { roles: [Role.ADMIN] }) (src/lib/auth/with-auth.ts —
/// it replaced requireAdmin() in phase 0.5.1.6), not by this row's
/// branchId — resolved in phase-0.5.1-auth-and-branches.md.
model Membership {
  id       String @id @default(cuid())
  userId   String
  branchId String
  role     Role

  permissions Permission[] @default([])

  /// Set when an administrator deactivates the person. The row stays (history, a way back) but it is no longer a membership: every reader
  /// treats a deactivated one as absent — `getUserMemberships`, `withAuth({ roles })`, the sign-in admin check, the member counts. Null for
  /// every row that existed before this column did, so nobody is deactivated by the migration.
  deactivatedAt DateTime?

  /// Standing (task 0045). A suspension or a termination also sets `deactivatedAt`, which is what every authority check already reads; this says WHY it is set and, for a
  /// suspension, until when (lifted at the next sign-in once the date has passed).
  standing      StandingState @default(ACTIVE)
  standingUntil DateTime?     @db.Date

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  staffRecords         StaffRecord[]
  programStaff         ProgramStaff[]
  /// Where this person approves results in this branch (task 0039); empty = nowhere.
  resultApprovalScopes ResultApprovalScope[]

  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([branchId])
}

/// An invitation to join the school (the Users pages, a port of Octalve Edu's 0.5.4). The link carries a 256-bit random token in the URL
/// FRAGMENT; only its SHA-256 hash is stored here — a leaked database yields no usable link. Single-use (acceptedAt), revocable (revokedAt),
/// expiring (expiresAt). One OPEN invitation per address is a partial unique index in the migration SQL (Prisma cannot express it).
model Invitation {
  id       String @id @default(cuid())
  /// Lower-cased. The invitation is for whoever controls this address; opening the link is the proof.
  email    String
  role     Role
  branchId String

  tokenHash String @unique

  invitedById   String?
  acceptedById  String?
  /// The staff record this invitation was sent from (task 0114, task 0101 D6): accepting it links the new account to that record. Null for an invitation typed by hand.
  staffRecordId String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invitedBy   User?        @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy  User?        @relation("InvitationsAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  staffRecord StaffRecord? @relation(fields: [staffRecordId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([staffRecordId])
  @@index([createdAt])
}
