// --- School structure (PRD §3): one school, four branches ---

/// The four legacy sections, unified: Secondary (English), Primary (English),
/// Secondary (Arabic), Primary (Arabic) — seeded once, at setup. No `code`
/// field: unlike Octalve Edu's Tenant, nothing ever routes on it.
model Branch {
  id   String @id @default(cuid())
  name String @unique

  memberships       Membership[]
  invitations       Invitation[]
  sessions          AcademicSession[]
  periods           AcademicPeriod[]
  students          StudentRecord[]
  enrollments       StudentEnrollment[]
  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  TEACHING_STAFF
  NON_TEACHING_STAFF
  STUDENT
  PARENT
}

/// Same fixed, deliberately small permission set as Octalve Edu (shared
/// design — see octalve-edu's domain-implementation-plan.md §1.7). ADMIN
/// implicitly has every permission; this only grants a non-admin extra
/// capability without making them a full admin.
enum Permission {
  CAN_APPROVE_RESULTS
  CAN_MANAGE_FINANCE
  CAN_PUBLISH_CONTENT
  CAN_MANAGE_USERS
}

/// A person's standing in the school. Every membership is branch-scoped,
/// including ADMIN's — an admin's own membership row anchors to one branch
/// (whichever the setup wizard or an invite assigned), but the ADMIN role
/// itself is authorized across every branch at the application layer via
/// withAuth(handler, { roles: [Role.ADMIN] }) (src/lib/auth/with-auth.ts —
/// it replaced requireAdmin() in phase 0.5.1.6), not by this row's
/// branchId — resolved in phase-0.5.1-auth-and-branches.md.
model Membership {
  id       String @id @default(cuid())
  userId   String
  branchId String
  role     Role

  permissions Permission[] @default([])

  /// Set when an administrator deactivates the person. The row stays (history, a way back) but it is no longer a membership: every reader
  /// treats a deactivated one as absent — `getUserMemberships`, `withAuth({ roles })`, the sign-in admin check, the member counts. Null for
  /// every row that existed before this column did, so nobody is deactivated by the migration.
  deactivatedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([branchId])
}

/// An invitation to join the school (the Users pages, a port of Octalve Edu's 0.5.4). The link carries a 256-bit random token in the URL
/// FRAGMENT; only its SHA-256 hash is stored here — a leaked database yields no usable link. Single-use (acceptedAt), revocable (revokedAt),
/// expiring (expiresAt). One OPEN invitation per address is a partial unique index in the migration SQL (Prisma cannot express it).
model Invitation {
  id       String @id @default(cuid())
  /// Lower-cased. The invitation is for whoever controls this address; opening the link is the proof.
  email    String
  role     Role
  branchId String

  tokenHash String @unique

  invitedById  String?
  acceptedById String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?

  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invitedBy  User?  @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?  @relation("InvitationsAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdAt])
}
