// --- School structure (PRD §3): one school, four branches ---

/// The four legacy sections, unified: Secondary (English), Primary (English),
/// Secondary (Arabic), Primary (Arabic) — seeded once, at setup. No `code`
/// field: unlike Octalve Edu's Tenant, nothing ever routes on it.
model Branch {
  id   String @id @default(cuid())
  name String @unique

  memberships Membership[]

  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  TEACHING_STAFF
  NON_TEACHING_STAFF
  STUDENT
  PARENT
}

/// Same fixed, deliberately small permission set as Octalve Edu (shared
/// design — see octalve-edu's domain-implementation-plan.md §1.7). ADMIN
/// implicitly has every permission; this only grants a non-admin extra
/// capability without making them a full admin.
enum Permission {
  CAN_APPROVE_RESULTS
  CAN_MANAGE_FINANCE
  CAN_PUBLISH_CONTENT
  CAN_MANAGE_USERS
}

/// A person's standing in the school. Every membership is branch-scoped,
/// including ADMIN's — an admin's own membership row anchors to one branch
/// (whichever the setup wizard or an invite assigned), but the ADMIN role
/// itself is authorized across every branch at the application layer via
/// withAuth(handler, { roles: [Role.ADMIN] }) (src/lib/auth/with-auth.ts —
/// it replaced requireAdmin() in phase 0.5.1.6), not by this row's
/// branchId — resolved in phase-0.5.1-auth-and-branches.md.
model Membership {
  id       String @id @default(cuid())
  userId   String
  branchId String
  role     Role

  permissions Permission[] @default([])

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([branchId])
}
