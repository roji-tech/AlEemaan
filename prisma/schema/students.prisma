// --- Student Domain & Records (Plan §Roadmap Phase 2) ---

enum Gender {
  MALE
  FEMALE
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  REPEATED
  WITHDRAWN
  TRANSFERRED
  ALUMNI
  /// Set when a pupil is expelled (task 0045): every module that selects pupils by ACTIVE enrolment (attendance rolls, invoice generation, result sheets, the promotion rollover)
  /// stops seeing them without being changed.
  EXPELLED
}

/// A pupil/student. admissionNo is human-facing, generated as YYYY/NNNN or assigned by the school.
model StudentRecord {
  id            String        @id @default(cuid())
  branchId      String
  firstName     String
  middleName    String?
  lastName      String
  gender        Gender
  /// Not required (the maintainer, 2026-11-18: only the first name, the last name and the gender are).
  dateOfBirth   DateTime?     @db.Date
  admissionNo   String        @unique
  archivedAt    DateTime?
  /// Standing (task 0045): ACTIVE, SUSPENDED (until `standingUntil`, or until lifted when null) or EXPELLED. Separate from archiving, which hides the record.
  standing      StandingState @default(ACTIVE)
  standingUntil DateTime?     @db.Date
  /// Day pupil or boarder (task 0113 R1, the maintainer 2026-11-19: "we have day students and burden students, we need to be able to classify"). Null = not set: no default, so no
  /// pupil is labelled wrongly.
  residence     Residence?

  /// A read-only MIRROR of the pupil's first allowed guardian (task 0113 D3): written only by `syncGuardianMirror` (lib/guardians/service.ts) from the `guardians` links, main contact
  /// first, and empty when every guardian is blocked. Kept so the readers (broadcasts, programs, exports, finance, the lookup tool) work unchanged until they move to the links.
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  /// The pupil's school-issued access code (task 0113, task 0094 D7/D9) for the student. sign-in. Only a slow, peppered hash is kept; the code itself is shown once to the administrator
  /// who makes it. Null until one is issued. (A guardian's code is on the guardian.)
  pupilCodeHash String?
  pupilCodeAt   DateTime?
  /// Raised whenever the pupil code is regenerated: a pupil sign-in made before carries the old number and ends at its next request (task 0094 D7, revocation).
  portalVersion Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  branch                Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  enrollments           StudentEnrollment[]
  attendanceRecords     AttendanceRecord[]
  results               Result[]
  remarks               ReportRemark[]
  invoices              Invoice[]
  assignmentSubmissions AssignmentSubmission[]
  quizAttempts          QuizAttempt[]
  guardianLinkTokens    GuardianLinkToken[]
  promotionRecords      PromotionRecord[]
  practiceSessions      PracticeSession[]
  practiceAttempts      PracticeAttempt[]
  questionReports       QuestionReport[]       @relation("ReportPupil")
  formResponses         FormResponse[]         @relation("StudentFormResponses")
  formTurnIns           FormTurnIn[]           @relation("StudentTurnIns")
  printLogs             QuestionBankPrintLog[] @relation("PrintLogStudent")
  programPlaces         ProgramParticipant[]
  receivedPrintLogs     QuestionBankPrintLog[] @relation("PrintLogRecipient")
  guardians             StudentGuardian[]
  scholarships          StudentScholarship[]

  @@unique([branchId, id])
  @@index([branchId])
  @@index([branchId, firstName, lastName])
  @@index([branchId, residence])
}

enum Residence {
  DAY
  BOARDING
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

/// A pupil's guardian, a record of its own (task 0113 D1, the maintainer 2026-11-19: "why don't we separate the guardian info and just use foreign key to connect it"). One person across
/// every branch; linked to each child by `StudentGuardian`. Phone and e-mail are NOT unique: two guardians may share a phone.
model Guardian {
  id            String    @id @default(cuid())
  name          String
  /// As typed, spaces and dashes removed.
  phone         String?
  /// The national digits of `phone` (`0803…` and `+234803…` are one number): how a guardian is found by phone and how a phone sign-in is compared.
  phoneKey      String?
  /// Lower case.
  email         String?
  /// The guardian's access code (task 0113 D7): one per guardian, whatever the number of children. Only a slow, peppered hash; null until one is made.
  codeHash      String?
  codeAt        DateTime?
  /// Raised by a new code, a block or an unblock: a guardian sign-in made before carries the old number and ends at its next request.
  portalVersion Int       @default(0)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  children StudentGuardian[]

  @@index([phoneKey])
  @@index([email])
  @@index([name])
}

/// A child and one of their guardians (task 0113 D1, D5). `branchId` is the child's branch, kept equal to it by the foreign key on (branch, pupil), which follows a change of branch.
/// A blocked link (the maintainer: "block access to some students under a guardian"): that guardian cannot sign in with this child, does not see them, and is not this child's contact.
model StudentGuardian {
  id            String                @id @default(cuid())
  studentId     String
  guardianId    String
  branchId      String
  relationship  GuardianRelationship?
  /// The child's main contact (at most one per child is kept by the service).
  isMain        Boolean               @default(false)
  blockedAt     DateTime?
  blockedById   String?
  blockedReason String?
  createdAt     DateTime              @default(now())

  student  StudentRecord @relation(fields: [branchId, studentId], references: [branchId, id], onDelete: Cascade, onUpdate: Cascade)
  guardian Guardian      @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@index([branchId])
}

/// Sequence counter for admission numbers per year (school-wide).
model AdmissionCounter {
  year Int @id
  next Int @default(1)
}

/// Links a student to an academic session and class arm for that year.
model StudentEnrollment {
  id         String           @id @default(cuid())
  studentId  String
  branchId   String
  sessionId  String
  className  String // e.g. "JSS 1", "Basic 2"
  arm        String? // e.g. "A", "Gold"
  /// The real arm this enrolment is in, when the strings above match one of the branch's arms (Slice P1a). Null until then; the strings stay until after Phase 7.
  classArmId String?
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt

  student                StudentRecord     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch                 Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  session                AcademicSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classArm               ClassArm?         @relation(fields: [branchId, classArmId], references: [branchId, id], onDelete: NoAction)
  sourcePromotionRecords PromotionRecord[] @relation("SourceEnrollmentRecords")
  targetPromotionRecords PromotionRecord[] @relation("TargetEnrollmentRecords")

  @@unique([studentId, sessionId])
  @@index([branchId, sessionId])
}
