// --- Student Domain & Records (Plan §Roadmap Phase 2) ---

enum Gender {
  MALE
  FEMALE
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  REPEATED
  WITHDRAWN
  TRANSFERRED
  ALUMNI
  /// Set when a pupil is expelled (task 0045): every module that selects pupils by ACTIVE enrolment (attendance rolls, invoice generation, result sheets, the promotion rollover)
  /// stops seeing them without being changed.
  EXPELLED
}

/// A pupil/student. admissionNo is human-facing, generated as YYYY/NNNN or assigned by the school.
model StudentRecord {
  id          String    @id @default(cuid())
  branchId    String
  firstName   String
  middleName  String?
  lastName    String
  gender      Gender
  dateOfBirth DateTime  @db.Date
  admissionNo String    @unique
  archivedAt  DateTime?
  /// Standing (task 0045): ACTIVE, SUSPENDED (until `standingUntil`, or until lifted when null) or EXPELLED. Separate from archiving, which hides the record.
  standing      StandingState @default(ACTIVE)
  standingUntil DateTime?     @db.Date

  guardianName  String?
  guardianPhone String?
  guardianEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  enrollments       StudentEnrollment[]
  attendanceRecords AttendanceRecord[]
  results           Result[]
  remarks           ReportRemark[]
  invoices          Invoice[]
  assignmentSubmissions AssignmentSubmission[]
  quizAttempts          QuizAttempt[]
  guardianLinkTokens    GuardianLinkToken[]
  promotionRecords      PromotionRecord[]
  practiceSessions      PracticeSession[]
  practiceAttempts      PracticeAttempt[]
  questionReports       QuestionReport[]    @relation("ReportPupil")
  formResponses         FormResponse[]      @relation("StudentFormResponses")
  formTurnIns           FormTurnIn[]        @relation("StudentTurnIns")
  printLogs             QuestionBankPrintLog[] @relation("PrintLogStudent")
  receivedPrintLogs     QuestionBankPrintLog[] @relation("PrintLogRecipient")

  @@unique([branchId, id])
  @@index([branchId])
  @@index([branchId, firstName, lastName])
}

/// Sequence counter for admission numbers per year (school-wide).
model AdmissionCounter {
  year Int @id
  next Int @default(1)
}

/// Links a student to an academic session and class arm for that year.
model StudentEnrollment {
  id         String           @id @default(cuid())
  studentId  String
  branchId   String
  sessionId  String
  className  String // e.g. "JSS 1", "Basic 2"
  arm        String? // e.g. "A", "Gold"
  /// The real arm this enrolment is in, when the strings above match one of the branch's arms (Slice P1a). Null until then; the strings stay until after Phase 7.
  classArmId String?
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt

  student  StudentRecord   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  session  AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classArm               ClassArm?         @relation(fields: [branchId, classArmId], references: [branchId, id], onDelete: NoAction)
  sourcePromotionRecords PromotionRecord[] @relation("SourceEnrollmentRecords")
  targetPromotionRecords PromotionRecord[] @relation("TargetEnrollmentRecords")

  @@unique([studentId, sessionId])
  @@index([branchId, sessionId])
}
