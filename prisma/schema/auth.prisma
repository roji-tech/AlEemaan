// --- Auth, rebuilt from scratch 2026-09-30 against the hardened design in
// docs/development-history/domain-implementation-plan.md §0.5.1.5. ---
//
// Auth.js is no longer used at all (previously kept only for its Prisma
// adapter / auth() helper). Dropped here, not just unmounted, because the
// hardened design requires storing a HASH of the session token
// (Session.tokenHash below) while the client's cookie holds the plaintext —
// Auth.js's PrismaAdapter looks sessions up by the raw cookie value, so it
// can never find a hashed row without being patched. Writing this project's
// own ~40-line session helper (src/lib/auth/session.ts) instead of
// monkey-patching a third-party adapter was the option both an internal
// two-AI security review and this project's own plan doc called viable for
// AlEemaan specifically (unlike Octalve Edu, which still has an open,
// undecided "evaluate Better Auth" question — this project isn't blocked on
// that decision being made first).
//
// No `Account` model: it only ever existed for Auth.js's OAuth provider
// flow, which was never used (email+password only) and is now moot with
// Auth.js gone entirely.

// NOT expressible in Prisma's schema language, applied in the migration SQL
// instead: CHECK ("email" = lower("email")) on User — email case-insensitivity
// enforced in Postgres itself, so a seed script or direct SQL import can't
// bypass the app-layer normalization (migration
// 20260930100000_two_level_sessions_and_email_check).

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Nullable — an invited-but-not-yet-activated user has none.
  passwordHash  String?

  sessions          Session[]
  resetTokens       PasswordResetToken[]
  emailChangeTokens EmailChangeToken[]
  memberships       Membership[]
  mfaCredential     MfaCredential?
  mfaRecoveryCodes  MfaRecoveryCode[]
  mfaChallenges     MfaChallenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// tokenHash, not the plaintext token — the client's cookie holds the
/// plaintext 256-bit random value; only its SHA-256 hash is ever written
/// here, so a leaked database (backup, a read-only SQL injection elsewhere)
/// yields no directly-replayable session.
///
/// Two expiries, deliberately (synced from Octalve Edu, §0.5.1.6): `expires`
/// is the IDLE expiry (slides forward on use, throttled), `absoluteExpires` is
/// a hard cap set at login and never extended (shorter for ADMIN) — so a
/// stolen-but-kept-alive session still dies.
///
/// createdAt/lastUsedAt/userAgent exist for the eventual "active devices"
/// revocation UI (not built yet) — added now since it's cheap to add alongside
/// this model's other changes and expensive to retrofit once real session rows
/// exist.
model Session {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  userId          String
  expires         DateTime
  absoluteExpires DateTime

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Password-reset links (domain-implementation-plan.md §0.5.C). Same rule as sessions: only a HASH of the
/// token is stored — the plaintext exists only in the emailed link — so a leaked database yields no usable
/// link. Single use (`usedAt`, claimed with a conditional update) and short-lived (`expiresAt`).
/// Replaces the Auth.js-era `VerificationToken` model, which was never used.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Two-step verification (domain-implementation-plan.md §0.5.D) -------------------------------------
// TOTP (RFC 6238) plus single-use recovery codes. The second factor is enforced AT SIGN-IN: a person who
// has a confirmed credential never gets a session from their password alone (see MfaChallenge).

/// One authenticator per person. `secretEnc` is the TOTP secret AES-256-GCM-encrypted under
/// MFA_ENCRYPTION_KEY (bound to `userId` as AAD) — it must be readable to check a code, so it cannot be
/// hashed, and it is never stored in the clear. A credential with `confirmedAt` null is an enrolment in
/// progress, NOT an active factor: sign-in ignores it until the person has proved they can produce a code.
model MfaCredential {
  id           String    @id @default(cuid())
  userId       String    @unique
  secretEnc    String
  confirmedAt  DateTime?
  /// The highest 30-second step already accepted. A code for this step or any earlier one is refused, so
  /// a code can't be used twice (replay / shoulder-surfing). Advanced with a conditional update, so two
  /// simultaneous submissions of one code can't both win.
  lastUsedStep Int?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Ten single-use codes per person, replaced as a set. `codeHash` is an HMAC (keyed from
/// MFA_ENCRYPTION_KEY), never the code: the codes have 50 bits, so a plain hash could be ground offline.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId])
}

/// The "pending MFA" state between a correct password and a correct second factor. It is NOT a session:
/// no cookie, and withAuth cannot see it. The plaintext token (256 bits) exists only in the JSON response
/// to sign-in step 1, held in memory by the sign-in page; only its SHA-256 hash is stored. Short-lived,
/// a handful of attempts, single use. `remember` carries the "Keep me signed in" choice made at step 1.
model MfaChallenge {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  remember  Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A pending change of a person's email address (domain-implementation-plan.md §0.5.E). Same rules as the
/// password-reset links: only a HASH of the token is stored (the plaintext exists only in the link mailed to the
/// NEW address), it is single use (`usedAt`, claimed with a conditional update) and short-lived (1 hour). It
/// carries the address it will switch to, which is why it is a table of its own. One live request per person.
model EmailChangeToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  newEmail  String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
