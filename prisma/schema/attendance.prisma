// --- Attendance Tracking Domain (Port of Octalve Edu Phase 1.3) ---

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum AttendanceSource {
  ONLINE
  OFFLINE_SYNC
}

/// Daily roll call record for a student on a specific date.
model AttendanceRecord {
  id             String           @id @default(cuid())
  branchId       String
  studentId      String
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  remarks        String?
  source         AttendanceSource @default(ONLINE)
  markedByUserId String?
  markedAt       DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  branch  Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([branchId, date])
  @@index([studentId])
}

/// Explicit grant allowing a staff member to view and mark attendance roll-call for a specific arm in this branch.
model AttendanceGrant {
  id              String   @id @default(cuid())
  branchId        String
  staffRecordId   String
  classArmId      String
  grantedByUserId String?
  grantedAt       DateTime @default(now())

  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffRecord   StaffRecord @relation(fields: [branchId, staffRecordId], references: [branchId, id], onDelete: Cascade)
  classArm      ClassArm    @relation(fields: [branchId, classArmId], references: [branchId, id], onDelete: Cascade)
  grantedByUser User?       @relation("AttendanceGrantsGranted", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([branchId, staffRecordId, classArmId])
  @@index([branchId])
  @@index([staffRecordId])
  @@index([classArmId])
}
