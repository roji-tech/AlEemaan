// --- Finance & Billing (Slice P4: Fee Structures, Invoices, Payments, Dual-Mode Paystack & Webhooks) ---

/// Whether a fee line is for pupils new to the school that period or for returning ones (task 0122).
enum FeeAdmission {
  NEW
  RETURNING
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  WAIVED
  CANCELLED
}

enum PaymentProvider {
  MANUAL
  PAYSTACK
  FLUTTERWAVE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountWorkflowMode {
  MANUAL_OVERRIDE
  SCHOLARSHIP
  SIBLING_DISCOUNT
  STAFF_CHILD
}

/// Fee structure item per academic period, optionally scoped to a class group (null = applies to all classes in branch).
model FeeStructure {
  id                String        @id @default(cuid())
  branchId          String
  periodId          String
  classGroupId      String?
  name              String // "Tuition", "Sports Levy", "PTA", "Books", etc.
  amount            Decimal       @db.Decimal(12, 2)
  /// Who the line is for (task 0122). Each is null = everyone, so a line made before these existed is billed to every pupil of its class, as it always was. A pupil is NEW for a period when they
  /// have no enrolment in a session that began earlier (worked out, never typed); gender and residence are the pupil's own. A pupil whose record lacks a value a line asks for does not get the line.
  audienceAdmission FeeAdmission?
  audienceGender    Gender?
  audienceResidence Residence?
  /// An optional line is billed unless the pupil opted out of it (StudentFeeOptOut).
  optional          Boolean       @default(false)
  /// false: a scholarship's percent is not taken of this line (uniforms, the ID card). The invoice's snapshot carries it, so every place that works a scholarship out agrees. Default true = as before.
  scholarshipCovers Boolean       @default(true)
  /// A physical item (uniform, cardigan, sport wear): a pupil's receipt of it can be recorded (FeeItemHandover). Records only; it never blocks an invoice or a payment.
  trackHandover     Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  period     AcademicPeriod     @relation(fields: [branchId, periodId], references: [branchId, id], onDelete: Cascade)
  classGroup ClassGroup?        @relation(fields: [branchId, classGroupId], references: [branchId, id], onDelete: NoAction)
  optOuts    StudentFeeOptOut[]
  handovers  FeeItemHandover[]

  @@unique([branchId, id])
  @@index([branchId, periodId])
  @@index([branchId, classGroupId])
}

/// Student term invoice with line-items snapshot and live payment balance.
model Invoice {
  id          String        @id @default(cuid())
  branchId    String
  studentId   String
  periodId    String
  invoiceNo   String // e.g. INV-2026-0001
  totalAmount Decimal       @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(12, 2)
  status      InvoiceStatus @default(UNPAID)
  dueDate     DateTime?     @db.Date
  /// Task 0046: the invoice must be settled in one payment. Can only tighten the school's part-payment rule, never loosen it.
  payInFull   Boolean       @default(false)
  lineItems   Json? // Snapshot of fee structures [{ name, amount, feeStructureId }]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  branch    Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student   StudentRecord     @relation(fields: [branchId, studentId], references: [branchId, id], onDelete: Cascade)
  period    AcademicPeriod    @relation(fields: [branchId, periodId], references: [branchId, id], onDelete: Cascade)
  payments  Payment[]
  discounts InvoiceDiscount[]

  @@unique([branchId, studentId, periodId])
  @@unique([invoiceNo])
  @@unique([branchId, id])
  @@index([branchId, status])
  @@index([branchId, periodId])
  @@index([branchId, studentId])
}

/// Payment transaction record (online gateway or recorded manual payment).
model Payment {
  id                 String          @id @default(cuid())
  branchId           String
  invoiceId          String
  amount             Decimal         @db.Decimal(12, 2)
  provider           PaymentProvider @default(PAYSTACK)
  providerRef        String // Unique transaction reference
  status             PaymentStatus   @default(PENDING)
  verifiedServerSide Boolean         @default(false)
  channel            String? // "card", "bank_transfer", "cash", "pos", "mock"
  paidAt             DateTime?
  receiptNo          String? // RCP-2026-0001
  metadata           Json?
  recordedByUserId   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [branchId, invoiceId], references: [branchId, id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@unique([branchId, id])
  @@index([branchId, invoiceId])
  @@index([branchId, status])
  @@index([branchId, providerRef])
}

/// Audited fee discounts, waivers or scholarships applied to an invoice.
model InvoiceDiscount {
  id                   String               @id @default(cuid())
  branchId             String
  invoiceId            String
  amount               Decimal              @db.Decimal(12, 2)
  reason               String
  mode                 DiscountWorkflowMode @default(MANUAL_OVERRIDE)
  appliedByUserId      String
  approvedByUserId     String?
  /// The scholarship this discount came from (task 0113 S1), when it is a scholarship's. At most one per scholarship per invoice (the unique index below), so applying a scholarship to an
  /// invoice twice, by generation and by "Apply to open invoices", can never double it. Many manual discounts have null here; they never clash.
  studentScholarshipId String?
  createdAt            DateTime             @default(now())

  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invoice            Invoice             @relation(fields: [branchId, invoiceId], references: [branchId, id], onDelete: Cascade)
  studentScholarship StudentScholarship? @relation(fields: [studentScholarshipId], references: [id], onDelete: SetNull)

  @@unique([branchId, id])
  @@unique([invoiceId, studentScholarshipId])
  @@index([branchId, invoiceId])
}

/// A kind of scholarship a branch gives (task 0113 S1, the maintainer 2026-11-19: "scholarship can be of different types"): a name and a default share of each invoice it covers, 1 to 100 (100 =
/// full). Archived, not deleted: pupils who hold it keep it. A name is used once among a branch's live types (checked by the service).
model ScholarshipType {
  id          String    @id @default(cuid())
  branchId    String
  name        String
  /// 1 to 100 (a CHECK in the migration).
  percent     Int
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  branch Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  grants StudentScholarship[]

  @@unique([branchId, id])
  @@index([branchId, archivedAt])
}

/// A pupil holding a scholarship (task 0113 S1): a type, the share it covers for this pupil (copied from the type, changeable), from and to days (null = open ended), a note. A pupil may hold
/// several at once; their live shares together may not exceed 100 (the service checks it in a transaction). Ended, never deleted. Financial: only an administrator of the pupil's branch (or a
/// superadmin) sees it; teachers and the family portal never receive it.
model StudentScholarship {
  id          String    @id @default(cuid())
  branchId    String
  studentId   String
  typeId      String
  /// 1 to 100 (a CHECK in the migration).
  percent     Int
  startsOn    DateTime? @db.Date
  endsOn      DateTime? @db.Date
  note        String?
  createdById String
  endedAt     DateTime?
  endedById   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  student   StudentRecord     @relation(fields: [branchId, studentId], references: [branchId, id], onDelete: Cascade, onUpdate: Cascade)
  type      ScholarshipType   @relation(fields: [typeId], references: [id], onDelete: Restrict)
  discounts InvoiceDiscount[]

  @@index([branchId, studentId])
  @@index([branchId, typeId])
}

/// Webhook audit ledger recording incoming gateway deliveries and signature verifications.
model PaymentWebhookEvent {
  id             String          @id @default(cuid())
  provider       PaymentProvider @default(PAYSTACK)
  eventId        String // Provider event/delivery ID
  eventType      String? // e.g. "charge.success"
  signatureValid Boolean
  processedAt    DateTime?
  rawPayloadHash String // SHA-256 hash of exact raw body, NEVER raw payload
  error          String?
  receivedAt     DateTime        @default(now())

  @@unique([provider, eventId])
  @@index([provider, receivedAt])
}

/// Per-branch, per-year receipt sequence
model ReceiptCounter {
  branchId String
  year     Int
  next     Int    @default(1)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([branchId, year])
}

/// Per-branch, per-year invoice sequence counter
model InvoiceCounter {
  branchId String
  year     Int
  next     Int    @default(1)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([branchId, year])
}

/// A pupil's choice not to take an optional fee line (task 0122: "turn off the school uniform for one new student"). One per pupil and line. Before the invoice exists the line is simply not put on it;
/// after, it is taken off only while nothing has been paid on the invoice (the service recomputes the total and the scholarship share). Financial: administrators of the branch and superadmins.
model StudentFeeOptOut {
  id             String   @id @default(cuid())
  branchId       String
  studentId      String
  feeStructureId String
  note           String?
  byUserId       String
  createdAt      DateTime @default(now())

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student      StudentRecord @relation(fields: [branchId, studentId], references: [branchId, id], onDelete: Cascade)
  feeStructure FeeStructure  @relation(fields: [branchId, feeStructureId], references: [branchId, id], onDelete: Cascade)

  @@unique([branchId, id])
  @@unique([studentId, feeStructureId])
  @@index([branchId, feeStructureId])
}

/// That a pupil has received a physical item (task 0122): the uniform, the cardigan, sport wear. One per pupil and line; undone by deleting it, and the audit log keeps who did what. It records only: no
/// invoice or payment waits for it. A fee line that has handovers cannot be deleted (the service says so).
model FeeItemHandover {
  id               String   @id @default(cuid())
  branchId         String
  studentId        String
  feeStructureId   String
  receivedOn       DateTime @db.Date
  receivedByUserId String
  note             String?
  createdAt        DateTime @default(now())

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student      StudentRecord @relation(fields: [branchId, studentId], references: [branchId, id], onDelete: Cascade)
  feeStructure FeeStructure  @relation(fields: [branchId, feeStructureId], references: [branchId, id], onDelete: NoAction)

  @@unique([branchId, id])
  @@unique([studentId, feeStructureId])
  @@index([branchId, feeStructureId])
}
