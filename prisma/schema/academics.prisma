// --- Academic Structure Foundation (Plan §Roadmap Phase 1) ---

enum SessionStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum PeriodKind {
  TERM
  SEMESTER
}

/// An academic year/session scoped to a branch (English branches run 3 terms, Arabic branches run 2 terms).
model AcademicSession {
  id        String        @id @default(cuid())
  branchId  String
  label     String // e.g. "2026/2027"
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  status    SessionStatus @default(PLANNED)

  archivedAt  DateTime?
  closeAt     DateTime?
  closeForced Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  branch                 Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  periods                AcademicPeriod[]
  enrollments            StudentEnrollment[]
  sourcePromotionBatches PromotionBatch[]    @relation("SourceSessionBatches")
  targetPromotionBatches PromotionBatch[]    @relation("TargetSessionBatches")

  @@unique([branchId, label])
  @@index([branchId, status])
}

/// A term or period within an academic session.
model AcademicPeriod {
  id        String     @id @default(cuid())
  branchId  String
  sessionId String
  kind      PeriodKind @default(TERM)
  ordinal   Int // 1, 2, 3
  label     String // e.g. "1st Term", "2nd Term", "3rd Term"
  startDate DateTime   @db.Date
  endDate   DateTime?  @db.Date
  isCurrent Boolean    @default(false)

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  session          AcademicSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results          Result[]
  remarks          ReportRemark[]
  feeStructures    FeeStructure[]
  invoices         Invoice[]
  breaks           AcademicBreak[]
  traitRatings     TraitRating[]
  reportAttendance ReportAttendance[]
  templateUses     ResultTemplateUse[]

  @@unique([sessionId, ordinal])
  @@unique([branchId, id])
  @@index([branchId, sessionId])
}

/// A break inside a term or semester (task 0098): the mid-term or mid-semester holiday. School does not run between its first and last day (both included); the term itself is unchanged.
/// It lies inside ONE period of the branch (the composite key keeps it in that period's branch) and breaks of a period never overlap (checked in the application: lib/academics/session-breaks.ts).
/// Nothing is deleted: a removed break is archived. Making an announcement for it is a separate, optional step: no link is kept.
model AcademicBreak {
  id         String    @id @default(cuid())
  branchId   String
  periodId   String
  label      String // e.g. "Mid-term break"
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date // the last day of the break (a one-day break has the same first and last day)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  branch Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  period AcademicPeriod @relation(fields: [branchId, periodId], references: [branchId, id], onDelete: Cascade)

  @@index([branchId, periodId])
}

// --- Academic structure: classes, arms, subjects (Slice P1a; plan "Build design - Slice P1") ---
//
// Everything belongs to exactly ONE branch. A child is kept in its parent's branch by a composite key (branchId, id), so the database - not only the code -
// refuses an arm that points at another branch's class group. Nothing is deleted: classes, arms and subjects are archived.

/// A class ("JSS 1", "Primary 3", "Ibtidaiyah 2") of one branch. `sortOrder` is the progression rung promotion will use. Live names are unique per branch
/// (ignoring case) by a partial index in the migration SQL.
model ClassGroup {
  id         String    @id @default(cuid())
  branchId   String
  name       String
  sortOrder  Int       @default(0)
  /// An optional second name for the class, like "Grade 7" for JSS 1 (task 0123): shown beside the class name on the report card and in the Classes list. Free text, at most 30 characters; null = none.
  gradeLabel String?
  /// The section this class is in ("Primary", "JSS", "SSS"), used to say where a person approves results (task 0039). Null = in no section. A section and its
  /// classes are of the same branch: the composite key below refuses any other.
  sectionId  String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  branch                 Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  section                Section?                @relation(fields: [branchId, sectionId], references: [branchId, id], onDelete: NoAction)
  approvalScopes         ResultApprovalScope[]
  arms                   ClassArm[]
  offerings              SubjectOffering[]
  schemes                AssessmentScheme[]
  schemeScopes           AssessmentSchemeScope[]
  resultTemplateClasses  ResultTemplateClass[]
  resultTemplateUses     ResultTemplateUse[]
  feeStructures          FeeStructure[]
  lmsAssignments         Assignment[]
  learningMaterials      LearningMaterial[]
  quizzes                Quiz[]
  sourcePromotionBatches PromotionBatch[]        @relation("SourceClassBatches")
  targetPromotionBatches PromotionBatch[]        @relation("TargetClassBatches")
  classGradeScale        ClassGradeScale?

  @@unique([branchId, id])
  @@index([branchId])
  @@index([branchId, sectionId])
}

/// A named group of classes of one branch ("Primary", "JSS", "SSS"), used to say where a person approves results (task 0039). Archived, never deleted: classes and approval
/// scopes point at it. Live names are unique per branch, ignoring case (a partial index in the migration SQL).
model Section {
  id         String    @id @default(cuid())
  branchId   String
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  branch         Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classGroups    ClassGroup[]
  approvalScopes ResultApprovalScope[]

  @@unique([branchId, id])
  @@index([branchId])
}

/// An arm of a class ("A", "Gold"). Capacity lives on the arm and is display-only. Live names are unique per class (ignoring case) by a partial index.
model ClassArm {
  id             String    @id @default(cuid())
  branchId       String
  classGroupId   String
  name           String
  capacity       Int?
  classTeacherId String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  branch           Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classGroup       ClassGroup               @relation(fields: [branchId, classGroupId], references: [branchId, id], onDelete: NoAction)
  classTeacher     StaffRecord?             @relation("ClassTeacherArms", fields: [branchId, classTeacherId], references: [branchId, id], onDelete: NoAction)
  enrollments      StudentEnrollment[]
  assignments      StaffSubjectAssignment[]
  results          Result[]
  attendanceGrants AttendanceGrant[]
  timetableSlots   TimetableSlot[]
  announcements    Announcement[]
  lmsAssignments   Assignment[]

  @@unique([branchId, id])
  @@index([branchId, classGroupId])
  @@index([branchId, classTeacherId])
}

/// A subject taught in one branch. `code` is upper-cased and unique among the branch's live subjects when present (partial index).
model Subject {
  id           String    @id @default(cuid())
  branchId     String
  name         String
  code         String?
  /// The department this subject belongs to, when the branch uses departments (task 0101 D7). At most one; null = in none. Of the same branch (the composite key below). It is NO ACTION,
  /// not SET NULL, because a composite key would null the branch too; a department is archived and never deleted, so nothing needs it.
  departmentId String?
  /// The school-wide catalogue entry this branch subject is an instance of (task 0119), or null. The row stays the BRANCH's own (every result, offering and assignment points at it with the
  /// branch-checked key); the link only says "this is the same subject as in the other branches". NO ACTION: a catalogue entry is archived, never deleted. One live subject per branch per
  /// entry (a partial unique index in the migration SQL).
  catalogId    String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  branch            Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  department        Department?              @relation(fields: [branchId, departmentId], references: [branchId, id], onDelete: NoAction)
  catalog           SubjectCatalog?          @relation(fields: [catalogId], references: [id], onDelete: NoAction)
  offerings         SubjectOffering[]
  assignments       StaffSubjectAssignment[]
  results           Result[]
  schemeScopes      AssessmentSchemeScope[]
  schemeDrafts      AssessmentSchemeDraft[]
  timetableSlots    TimetableSlot[]
  lmsAssignments    Assignment[]
  learningMaterials LearningMaterial[]
  quizzes           Quiz[]

  @@unique([branchId, id])
  @@index([branchId])
  @@index([branchId, departmentId])
  @@index([catalogId])
}

/// A subject of the SCHOOL, not of one branch (task 0119): the list a superadmin keeps once, and each branch takes the ones it teaches (a branch's own `Subject` row linked by `catalogId`).
/// Live names are unique ignoring case and live codes are unique when present (partial indexes in the migration SQL). Nothing is deleted: an entry is archived.
model SubjectCatalog {
  id         String    @id @default(cuid())
  name       String
  code       String?
  /// Labels only (Pre-school, Basic, Arabic, Core...): lower-case, trimmed, no repeats, at most 10 of 30 characters (the application normalises; a CHECK in the migration bounds the count). They
  /// give no access and change no result. A branch subject shows its entry's tags through `catalogId`. Only a superadmin edits them.
  tags       String[]  @default([])
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  subjects Subject[]
}

/// A department of a branch (task 0101 D7): a named group of staff, teaching or non-teaching (Sciences, Languages, Arabic and Islamic Studies, Bursary). Only used while the branch's setting
/// `academics.useDepartments` is on. Live names are unique per branch (ignoring case) by a partial index; nothing is deleted, a department is archived.
model Department {
  id          String    @id @default(cuid())
  branchId    String
  name        String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  branch        Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  members       DepartmentMember[]
  subjects      Subject[]
  resultReviews ResultDepartmentReview[]
  invitations   Invitation[]

  @@unique([branchId, id])
  @@index([branchId])
}

/// One person in one department (task 0101 D7). A person may be in several departments; a department has at most ONE head (a partial unique index on departmentId where isHead). The department and
/// the staff record are of the same branch: both composite keys carry it. Removed with the department or the staff record.
model DepartmentMember {
  id            String   @id @default(cuid())
  branchId      String
  departmentId  String
  staffRecordId String
  isHead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  department  Department  @relation(fields: [branchId, departmentId], references: [branchId, id], onDelete: Cascade)
  staffRecord StaffRecord @relation(fields: [branchId, staffRecordId], references: [branchId, id], onDelete: Cascade)

  @@unique([departmentId, staffRecordId])
  @@index([branchId])
  @@index([staffRecordId])
}

/// "This class studies this subject." A real DELETE for now because nothing references it; the day a later slice adds a foreign key to it, a test fails and
/// forces archive-on-reference.
model SubjectOffering {
  id           String   @id @default(cuid())
  branchId     String
  classGroupId String
  subjectId    String
  createdAt    DateTime @default(now())
  /// The place of this subject in the class's own order on the report card (task 0126): set from the order the subjects are saved in; null = never ordered by hand, so the order they were added in.
  sortOrder    Int?

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [branchId, classGroupId], references: [branchId, id], onDelete: NoAction)
  subject    Subject    @relation(fields: [branchId, subjectId], references: [branchId, id], onDelete: NoAction)

  @@unique([classGroupId, subjectId])
  @@index([branchId])
}

// --- Assessment schemes and grade scales (Slice P1b; plan "Build design - Slice P1", decisions 6 and 7) ---
//
// Both are VERSIONED so history cannot be rewritten: edited in place only while `lockedAt` is null; the first result that references one (P2) locks it, a trigger
// then refuses any change to it or its children, and a change after that is a NEW VERSION that supersedes it. Per branch; nothing is deleted.

/// How a mark is built: continuous-assessment components plus the exam, summing exactly to `totalMax`. classGroupId null = the branch default.
model AssessmentScheme {
  id           String    @id @default(cuid())
  branchId     String
  classGroupId String?
  name         String
  totalMax     Decimal   @default(100) @db.Decimal(6, 2)
  examMax      Decimal   @db.Decimal(6, 2)
  version      Int       @default(1)
  lockedAt     DateTime?
  supersedesId String?
  /// True for a school-wide or a teacher's own scheme: stored on a branch's row but not that branch's default, so the one-live-scheme-per-scope rule ignores it.
  hosted       Boolean   @default(false)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  branch     Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classGroup ClassGroup?             @relation(fields: [branchId, classGroupId], references: [branchId, id], onDelete: NoAction)
  supersedes AssessmentScheme?       @relation("SchemeVersions", fields: [branchId, supersedesId], references: [branchId, id], onDelete: NoAction)
  successors AssessmentScheme[]      @relation("SchemeVersions")
  components AssessmentComponent[]
  results    Result[]
  scopes     AssessmentSchemeScope[]
  templates  ResultTemplate[]

  @@unique([branchId, id])
  @@index([branchId])
}

model AssessmentComponent {
  id        String  @id @default(cuid())
  branchId  String
  schemeId  String
  name      String
  maxScore  Decimal @db.Decimal(6, 2)
  sortOrder Int

  branch Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scheme AssessmentScheme @relation(fields: [branchId, schemeId], references: [branchId, id], onDelete: NoAction)

  @@unique([branchId, id])
  @@index([branchId, schemeId])
}

/// A grade scale as data: bands of score -> letter -> remark. Exactly one live DEFAULT per branch (partial unique index in the migration).
model GradeScale {
  id           String    @id @default(cuid())
  branchId     String
  name         String
  isDefault    Boolean   @default(false)
  /// True for a scale whose bands were GUESSED, not printed on the school's card (the seeded junior scale, task 0116 D15). While true, results graded on it cannot be published; an administrator
  /// confirms the bands, or edits and saves them (a new version if results used it), and it clears.
  unconfirmed  Boolean   @default(false)
  version      Int       @default(1)
  lockedAt     DateTime?
  supersedesId String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supersedes     GradeScale?       @relation("ScaleVersions", fields: [branchId, supersedesId], references: [branchId, id], onDelete: NoAction)
  successors     GradeScale[]      @relation("ScaleVersions")
  bands          GradeBand[]
  results        Result[]
  templates      ResultTemplate[]
  classOverrides ClassGradeScale[]

  @@unique([branchId, id])
  @@index([branchId])
}

/// Half-open [minScore, maxScore), except the top band which is closed at 100; the bands of a scale are contiguous from 0 to 100 (checked by
/// lib/academics/scoring.ts#checkBands, in the write transaction).
model GradeBand {
  id        String  @id @default(cuid())
  branchId  String
  scaleId   String
  minScore  Decimal @db.Decimal(5, 2)
  maxScore  Decimal @db.Decimal(5, 2)
  letter    String
  remark    String
  sortOrder Int

  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scale  GradeScale @relation(fields: [branchId, scaleId], references: [branchId, id], onDelete: NoAction)

  @@unique([branchId, id])
  @@index([branchId, scaleId])
}

// --- Staff records and teaching assignments (Slice P1c; plan "Build design - Slice P1c") ---

enum StaffCategory {
  TEACHING
  NON_TEACHING
}

/// A member of staff as the BRANCH knows them - not a sign-in account. `userId` is null for someone who never signs in (a security guard, a driver); when set it
/// must be a member of this same branch (composite key to Membership) and is unique per branch (partial unique index). `email` is lower-cased and unique among
/// the branch's live records (partial index). Creating a record never creates a login.
model StaffRecord {
  id                    String        @id @default(cuid())
  /// The branch the record belongs to; null = not placed in a branch yet (task 0101 D3): only a superadmin sees and edits such a record, and it is left out of every branch's list, count, export and search until it is placed.
  branchId              String?
  userId                String?
  category              StaffCategory
  /// How the person is addressed: Mr, Mrs, Miss, Dr, Mallam, Ustadh… (task 0111). Optional, shown before the name.
  title                 String?
  firstName             String
  middleName            String?
  lastName              String
  gender                Gender?
  dateOfBirth           DateTime?     @db.Date
  phone                 String?
  email                 String?
  address               String?
  /// The job title (task 0111: "a specific title for non-teaching staff", e.g. Bursar, Driver); the form asks for it for non-teaching staff.
  designation           String?
  qualification         String?
  /// An NYSC corps member serving at the school (task 0101 D5, built in task 0111). Shown as a badge on the staff list.
  corpsMember           Boolean       @default(false)
  /// An optional free-text role label shown on the staff card (e.g. "Head of Science", "Form Tutor"). Different from `designation` (the job title of a non-teaching member stored for HR); this is a short display label for anyone.
  role                  String?
  /// One person's records in several branches share this id (task 0114, task 0101 R1): set when a record is transferred or added to another branch. Null for a person with one record.
  personId              String?
  /// A draft (task 0101 D1, batch 3a): saved unfinished, shown with a "Draft" badge, and left out of everything that counts or acts on staff (invitations, assignments, class teacher, linking an account, transfer, broadcasts, programs) until it is completed.
  isDraft               Boolean       @default(false)
  employmentDate        DateTime?     @db.Date
  nextOfKinName         String?
  nextOfKinRelationship String?
  nextOfKinPhone        String?
  nextOfKinAddress      String?
  archivedAt            DateTime?
  /// Standing (task 0045): ACTIVE, SUSPENDED (until `standingUntil`) or TERMINATED (the record is also archived).
  standing              StandingState @default(ACTIVE)
  standingUntil         DateTime?     @db.Date
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @default(now()) @updatedAt

  branch             Branch?                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  membership         Membership?              @relation(fields: [userId, branchId], references: [userId, branchId], onDelete: NoAction)
  assignments        StaffSubjectAssignment[]
  teacherOfArms      ClassArm[]               @relation("ClassTeacherArms")
  attendanceGrants   AttendanceGrant[]
  programPlaces      ProgramParticipant[]
  timetableSlots     TimetableSlot[]
  createdAssignments Assignment[]
  gradedSubmissions  AssignmentSubmission[]
  createdMaterials   LearningMaterial[]
  createdQuizzes     Quiz[]
  invitations        Invitation[]
  departments        DepartmentMember[]

  @@unique([branchId, id])
  @@index([branchId])
  @@index([personId])
  @@index([branchId, isDraft])
}

/// "This person teaches this subject to this arm." A real DELETE for now (nothing references it); the day a later slice does, a test fails and forces
/// archive-on-reference.
model StaffSubjectAssignment {
  id            String   @id @default(cuid())
  branchId      String
  staffRecordId String
  subjectId     String
  classArmId    String
  createdAt     DateTime @default(now())

  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord @relation(fields: [branchId, staffRecordId], references: [branchId, id], onDelete: NoAction)
  subject     Subject     @relation(fields: [branchId, subjectId], references: [branchId, id], onDelete: NoAction)
  classArm    ClassArm    @relation(fields: [branchId, classArmId], references: [branchId, id], onDelete: NoAction)

  @@unique([staffRecordId, subjectId, classArmId])
  @@index([branchId])
}

// --- Results (Slice P2a; plan "Build design - Slice P2") ---

enum ResultStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
  LOCKED
}

/// One student's result in one subject for one period. The arm, scheme and scale are SNAPSHOTTED onto it (the arm the student was in when it was entered; the
/// scheme and scale that built the numbers, which the first result locks), and the letter and remark are copied, not looked up later - so history cannot change when
/// a scheme, a scale or the student's class does. Content (scores, snapshot) can change only while the row is a DRAFT; the status machine, the dates and the
/// verification token are enforced by CHECKs and triggers in the migration SQL. One live row per student x subject x period.
model Result {
  id                String       @id @default(cuid())
  branchId          String
  studentId         String
  subjectId         String
  periodId          String
  classArmId        String
  schemeId          String
  scaleId           String
  /// [{ name, max, score }] in the scheme's order.
  componentScores   Json
  examScore         Decimal      @db.Decimal(6, 2)
  examMax           Decimal      @db.Decimal(6, 2)
  caTotal           Decimal      @db.Decimal(6, 2)
  total             Decimal      @db.Decimal(6, 2)
  maxScore          Decimal      @db.Decimal(6, 2)
  gradeLetter       String
  gradeRemark       String
  status            ResultStatus @default(DRAFT)
  enteredByUserId   String
  submittedByUserId String?
  submittedAt       DateTime?
  approvedByUserId  String?
  approvedAt        DateTime?
  publishedAt       DateTime?
  lockedAt          DateTime?
  verificationToken String?      @unique
  verificationHash  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student     StudentRecord    @relation(fields: [branchId, studentId], references: [branchId, id], onDelete: NoAction)
  subject     Subject          @relation(fields: [branchId, subjectId], references: [branchId, id], onDelete: NoAction)
  period      AcademicPeriod   @relation(fields: [branchId, periodId], references: [branchId, id], onDelete: NoAction)
  classArm    ClassArm         @relation(fields: [branchId, classArmId], references: [branchId, id], onDelete: NoAction)
  scheme      AssessmentScheme @relation(fields: [branchId, schemeId], references: [branchId, id], onDelete: NoAction)
  scale       GradeScale       @relation(fields: [branchId, scaleId], references: [branchId, id], onDelete: NoAction)
  enteredBy   User             @relation("ResultsEntered", fields: [enteredByUserId], references: [id], onDelete: NoAction)
  submittedBy User?            @relation("ResultsSubmitted", fields: [submittedByUserId], references: [id], onDelete: NoAction)
  approvedBy  User?            @relation("ResultsApproved", fields: [approvedByUserId], references: [id], onDelete: NoAction)

  /// The head of department's review (task 0101 F), when the branch asks for one.
  departmentReview ResultDepartmentReview?

  @@unique([studentId, subjectId, periodId])
  @@unique([branchId, id])
  @@index([branchId, periodId, classArmId])
  @@index([branchId, studentId, periodId])
}

/// What an approver's scope covers (task 0039): GENERAL = every class of the branch, SECTION = every class in one section, CLASS = one class (all its arms).
enum ApprovalScopeKind {
  GENERAL
  SECTION
  CLASS
}

/// Where one person approves results in one branch (task 0039). Only a member who holds CAN_APPROVE_RESULTS has rows; no rows means nothing to approve (fail closed). Rows are
/// added and removed, never edited. The migration adds what the schema cannot say: the kind/target CHECK and the unique index on (person, branch, kind, target).
model ResultApprovalScope {
  id           String            @id @default(cuid())
  branchId     String
  userId       String
  kind         ApprovalScopeKind
  sectionId    String?
  classGroupId String?
  createdById  String?
  createdAt    DateTime          @default(now())

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  membership Membership  @relation(fields: [userId, branchId], references: [userId, branchId], onDelete: Cascade)
  section    Section?    @relation(fields: [branchId, sectionId], references: [branchId, id], onDelete: NoAction)
  classGroup ClassGroup? @relation(fields: [branchId, classGroupId], references: [branchId, id], onDelete: NoAction)

  @@index([branchId, userId])
}

/// Append-only history of every result: each entry, edit, transition and unlock, in the same transaction as the change. UPDATE and DELETE are refused by triggers.
/// `resultId` carries no foreign key on purpose: a draft that is deleted keeps its trail. `actorUserId` is null for the system (a term closing locks its published results).
model ResultAudit {
  id          String        @id @default(cuid())
  branchId    String
  resultId    String
  actorUserId String?
  action      String
  fromStatus  ResultStatus?
  toStatus    ResultStatus?
  fromTotal   Decimal?      @db.Decimal(6, 2)
  toTotal     Decimal?      @db.Decimal(6, 2)
  reason      String?
  createdAt   DateTime      @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  actor  User?  @relation("ResultAudits", fields: [actorUserId], references: [id], onDelete: NoAction)

  @@index([branchId, resultId])
  @@index([createdAt])
}

/// A head of department's review of one SUBMITTED result (task 0101 F, the maintainer: department heads approving results, built behind a switch). While a branch has
/// `results.departmentHeadReview` on, a result whose subject belongs to a department needs one of these before it can be APPROVED; the head (or an administrator) makes it, never for results they
/// entered or submitted themselves. It is not a status and moves no result: PUBLISHING is unchanged and stays with the administrator or approver. Returning a result to DRAFT deletes its review
/// (the marks can change again). `reviewedByUserId` is a plain id, like the audit trail's: people are never deleted.
model ResultDepartmentReview {
  id               String   @id @default(cuid())
  branchId         String
  resultId         String
  departmentId     String
  reviewedByUserId String
  reviewedAt       DateTime @default(now())

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  result     Result     @relation(fields: [branchId, resultId], references: [branchId, id], onDelete: Cascade)
  department Department @relation(fields: [branchId, departmentId], references: [branchId, id], onDelete: NoAction)

  @@unique([branchId, resultId])
  @@index([branchId, departmentId])
}

/// The teacher's and the principal's remark on a student's report card for one term (Slice P2c). Editable until any of the student's results for that term is
/// published (a service rule, stated in the plan). One row per student and term.
model ReportRemark {
  id              String   @id @default(cuid())
  branchId        String
  studentId       String
  periodId        String
  teacherRemark   String?
  principalRemark String?
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student   StudentRecord  @relation(fields: [branchId, studentId], references: [branchId, id], onDelete: NoAction)
  period    AcademicPeriod @relation(fields: [branchId, periodId], references: [branchId, id], onDelete: NoAction)
  updatedBy User           @relation("RemarksUpdated", fields: [updatedByUserId], references: [id], onDelete: NoAction)

  @@unique([studentId, periodId])
  @@index([branchId, periodId])
}

/// A result template (task 0116): a named bundle of a look (layout), a marks structure (scheme) and a grade scale, assigned to classes of ONE branch. A class is in at most one
/// template (ResultTemplateClass is unique on branch + class); a class in none uses the branch's default template. Null layout, scheme or scale means "as the branch does today":
/// the branch's standard layout (Approvals > Report cards), its own class scheme or default scheme, and its default grade scale. A live name is unique per branch and exactly one live
/// template per branch is the default: both are partial unique indexes written in the migration (Prisma cannot express a WHERE).
model ResultTemplate {
  id                    String    @id @default(cuid())
  branchId              String
  name                  String
  description           String?
  /// "DEFAULT" or "LEGACY" (a ReportCardLayout code; no foreign key, the layouts are created the first time anyone asks). Null = the branch's standard layout.
  layoutCode            String?
  layoutOptions         Json?
  schemeId              String?
  gradeScaleId          String?
  isDefault             Boolean   @default(false)
  /// The school-wide template this row follows (task 0120), or null for a template of the branch's own. The row keeps ALL its branch-checked keys; the master only says what to copy into it.
  schoolTemplateId      String?
  /// The master's version this row was last brought up to (null when it follows none). Behind = lower than the master's version.
  schoolTemplateVersion Int?
  /// Set when someone in the branch changed the look, the marks scheme, the grade scale or the name of a row that follows a school template after it was synced ("Customised here"). A sync skips
  /// such a row unless the superadmin chooses to replace the local changes.
  localEditedAt         DateTime?
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  branch         Branch                     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  schoolTemplate SchoolResultTemplate?      @relation(fields: [schoolTemplateId], references: [id], onDelete: NoAction)
  scheme         AssessmentScheme?          @relation(fields: [branchId, schemeId], references: [branchId, id], onDelete: NoAction)
  gradeScale     GradeScale?                @relation(fields: [branchId, gradeScaleId], references: [branchId, id], onDelete: NoAction)
  classes        ResultTemplateClass[]
  uses           ResultTemplateUse[]
  traitGroups    ResultTemplateTraitGroup[]
  traits         ResultTemplateTrait[]

  @@unique([branchId, id])
  @@index([branchId])
  @@index([schoolTemplateId])
}

/// A school-wide result template (task 0120): the MASTER the branches' own ResultTemplate rows follow. It holds the look and a `definition` (the marks scheme, the grade scale with its bands and
/// whether they are unconfirmed, and the trait groups and traits, each with a stable key) as validated JSON (lib/results/school-templates-rules.ts). Only a superadmin changes it, and a change bumps
/// `version`; the branches' rows are brought up to it by "Update branches", never silently. Archived, never deleted: rows follow it. A live name is unique, ignoring case (a partial index in the
/// migration SQL).
model SchoolResultTemplate {
  id            String    @id @default(cuid())
  name          String
  description   String?
  layoutCode    String?
  layoutOptions Json?
  definition    Json
  version       Int       @default(1)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  rows ResultTemplate[]
}

model ResultTemplateClass {
  id           String   @id @default(cuid())
  branchId     String
  templateId   String
  classGroupId String
  createdAt    DateTime @default(now())

  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  template   ResultTemplate @relation(fields: [branchId, templateId], references: [branchId, id], onDelete: Cascade)
  classGroup ClassGroup     @relation(fields: [branchId, classGroupId], references: [branchId, id], onDelete: Cascade)

  @@unique([branchId, classGroupId])
  @@index([templateId])
}

/// Which template a class's report cards used for a term (task 0126): written by the first publish of that class's results for the period, so moving the class to another template later does not
/// change how that term prints. Cleared when an unlock leaves nothing of the class published for the period. A template that is deleted takes its rows, and the term then follows the class again.
model ResultTemplateUse {
  id           String   @id @default(cuid())
  branchId     String
  periodId     String
  classGroupId String
  templateId   String
  /// The template's look and trait groups as they were when this was recorded (task 0127), so editing the template later does not change this term. Null = follow the live template.
  snapshot     Json?
  createdAt    DateTime @default(now())

  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  period     AcademicPeriod @relation(fields: [branchId, periodId], references: [branchId, id], onDelete: Cascade)
  classGroup ClassGroup     @relation(fields: [branchId, classGroupId], references: [branchId, id], onDelete: Cascade)
  template   ResultTemplate @relation(fields: [branchId, templateId], references: [branchId, id], onDelete: Cascade)

  @@unique([branchId, periodId, classGroupId])
  @@index([templateId])
}

/// A group of traits on a template's report card (task 0116): "Psychomotor skill", "Affective domain", "Character development", "Practical skills". `showSign` adds the SIGN column the
/// secondary cards print beside the rating. Seeded per branch from the school's four cards (lib/results/seed-templates.ts) and editable.
model ResultTemplateTraitGroup {
  id         String   @id @default(cuid())
  branchId   String
  templateId String
  title      String
  sortOrder  Int      @default(0)
  showSign   Boolean  @default(false)
  /// The stable key of this group in the school template it follows (task 0120); null for a group of the branch's own. Sync matches on it, so a rename never orphans ratings.
  schoolKey  String?
  createdAt  DateTime @default(now())

  branch   Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  template ResultTemplate        @relation(fields: [branchId, templateId], references: [branchId, id], onDelete: Cascade)
  traits   ResultTemplateTrait[]

  @@unique([branchId, id])
  @@index([templateId])
}

/// One trait of a template (Punctuality, Games, ...), rated 1 to 5 for each pupil each term (TraitRating). A trait is archived, never deleted, so a past card still shows it.
model ResultTemplateTrait {
  id         String    @id @default(cuid())
  branchId   String
  templateId String
  groupId    String
  name       String
  sortOrder  Int       @default(0)
  /// The stable key of this trait inside its group in the school template it follows (task 0120); null for a trait of the branch's own.
  schoolKey  String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  branch   Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  template ResultTemplate           @relation(fields: [branchId, templateId], references: [branchId, id], onDelete: Cascade)
  group    ResultTemplateTraitGroup @relation(fields: [branchId, groupId], references: [branchId, id], onDelete: Cascade)
  ratings  TraitRating[]

  @@unique([branchId, id])
  @@index([templateId])
  @@index([groupId])
}

/// A pupil's rating (1 to 5, a CHECK in the migration) of one trait for one term, entered by the class teacher or an administrator and editable until the pupil's results for the term are
/// published, as the remarks are.
model TraitRating {
  id              String   @id @default(cuid())
  branchId        String
  studentId       String
  periodId        String
  traitId         String
  rating          Int
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student   StudentRecord       @relation(fields: [branchId, studentId], references: [branchId, id], onDelete: NoAction)
  period    AcademicPeriod      @relation(fields: [branchId, periodId], references: [branchId, id], onDelete: NoAction)
  trait     ResultTemplateTrait @relation(fields: [branchId, traitId], references: [branchId, id], onDelete: NoAction)
  updatedBy User                @relation("TraitRatingsUpdated", fields: [updatedByUserId], references: [id], onDelete: NoAction)

  @@unique([studentId, periodId, traitId])
  @@index([branchId, periodId])
}

/// Attendance numbers a person ENTERED for a pupil's term, overriding what the register gives (task 0116): times the school opened, times present, times absent. A null number means
/// "use the register's count"; nothing is invented when there is no register either (the card shows a dash).
model ReportAttendance {
  id              String   @id @default(cuid())
  branchId        String
  studentId       String
  periodId        String
  timesOpen       Int?
  timesPresent    Int?
  timesAbsent     Int?
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student   StudentRecord  @relation(fields: [branchId, studentId], references: [branchId, id], onDelete: NoAction)
  period    AcademicPeriod @relation(fields: [branchId, periodId], references: [branchId, id], onDelete: NoAction)
  updatedBy User           @relation("ReportAttendanceUpdated", fields: [updatedByUserId], references: [id], onDelete: NoAction)

  @@unique([studentId, periodId])
  @@index([branchId, periodId])
}

/// A class's own grade scale (task 0116, the maintainer 2026-11-20: "make the scale editable per class per branch"): it wins over the class's result template's scale and the branch's default.
/// A table of its own, not a column of ResultTemplateClass, so a class that is in no template (it uses the default one) can have its own scale too. One row per class; a row means "this class
/// grades on this scale"; no row means "follow the template, then the branch default". Same branch by composite keys; the scale is never deleted, so NoAction.
model ClassGradeScale {
  id           String   @id @default(cuid())
  branchId     String
  classGroupId String
  gradeScaleId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [branchId, classGroupId], references: [branchId, id], onDelete: Cascade)
  gradeScale GradeScale @relation(fields: [branchId, gradeScaleId], references: [branchId, id], onDelete: NoAction)

  @@unique([branchId, classGroupId])
  @@index([gradeScaleId])
}
