# Copy to .env and fill in. Never commit .env.

# --- Database (Postgres + Prisma) ---
DATABASE_URL="postgresql://aleemaan:aleemaan@localhost:5434/aleemaan"

# --- Tests (optional) ---
# `pnpm test` runs against "<database>_test" derived from DATABASE_URL above (created and migrated
# automatically). Set this to point it elsewhere — the database name MUST end in "_test"; every
# destructive test helper refuses to touch any other database.
# TEST_DATABASE_URL="postgresql://aleemaan:aleemaan@localhost:5434/aleemaan_test"

# --- Redis ---
REDIS_URL="redis://localhost:6381"

# --- Auth (hand-rolled, no Auth.js — see domain-implementation-plan.md §0.5.1.5) ---
# The app's real base URL. Its scheme (http:// vs https://) decides whether
# the session cookie gets the Secure flag and the __Host- prefix — NOT
# NODE_ENV, since a Solo/LAN install can legitimately run in production mode
# over plain HTTP. Leave unset (or http://) for local dev.
APP_URL="http://localhost:3000"

# Which header carries the real client IP for rate limiting. Must be a header
# YOUR reverse proxy sets/overwrites — never one the client can supply.
#   x-real-ip       (default) e.g. nginx: proxy_set_header X-Real-IP $remote_addr;
#                   Caddy: header_up X-Real-IP {remote_host}
#   x-forwarded-for reads the Nth entry from the RIGHT (N = TRUSTED_PROXY_HOPS);
#                   entries to the left are client-controlled and never read.
# Unset/absent header (plain local dev) = one shared "unproxied" bucket.
CLIENT_IP_HEADER=x-real-ip
TRUSTED_PROXY_HOPS=1

# Behind a reverse proxy: CSRF compares the request's Origin with the host the browser used. By default that is the
# `Host` header, so the proxy must PASS IT THROUGH (nginx: `proxy_set_header Host $host;` — Caddy does by default).
# If your proxy rewrites Host, set this to "true" AND make the proxy OVERWRITE X-Forwarded-Host (never append): only then
# is that header believed. Left false, X-Forwarded-Host is ignored, so a non-browser client cannot choose the host.
TRUST_FORWARDED_HOST=false

# --- Breached-password check (runs only when a password is CHOSEN: setup, reset, change) ---
# Asks Have I Been Pwned's range API; only the first 5 characters of the password's SHA-1 leave the server. A down
# service never blocks anyone (fail open). Set to "off" on an air-gapped install. PWNED_PASSWORD_URL is for tests.
PWNED_PASSWORD_CHECK=on
# PWNED_PASSWORD_URL="https://api.pwnedpasswords.com/range/"

# --- First-run setup wizard ---
# Optional defense-in-depth: if set, /setup requires this value too.
SETUP_TOKEN=

# --- Payments (PRD §7 — gateway + manual) ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# --- Outgoing email (password reset / change notices) ---
# resend | console | file. Unset: resend if RESEND_API_KEY is set, else console (prints links to the log —
# fine for development, delivers to no one in production).
EMAIL_TRANSPORT=
# The sender, e.g. "Your School <no-reply@yourschool.com>" (a domain verified with Resend).
EMAIL_FROM=

# --- Two-step verification (TOTP) ---
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts every authenticator secret at rest and keys the
# recovery-code hashes. REQUIRED for two-step verification to be available at all (without it the account page
# says so and enrolment answers 503 — there is deliberately no default). Keep it out of the database and backups
# of it; losing it means everyone must set two-step verification up again (`pnpm mfa:reset -- <email>`).
MFA_ENCRYPTION_KEY=

# --- Development tools (the in-app dev email inbox; a mock payment checkout later) ---
# What kind of deployment this is: development | staging | production. Unset: production under `next start`
# (NODE_ENV=production), development under `next dev`. ANY other value is treated as production — fail closed.
APP_ENV=
# Local development: the tools are on by default (set false to hide them). Staging: set true AND DEV_TOOLS_TOKEN.
# Production: never available, whatever these say.
DEV_TOOLS=
# Staging only — a shared secret typed once into the dev inbox widget. Without it the tools stay off on staging
# (the inbox holds password-reset links and security notices, so it must not be readable by anyone who finds the URL).
DEV_TOOLS_TOKEN=
