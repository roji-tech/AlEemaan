# Copy to .env and fill in. Never commit .env.

# --- Database (Postgres + Prisma) ---
DATABASE_URL="postgresql://aleemaan:aleemaan@localhost:5434/aleemaan"

# --- Redis ---
REDIS_URL="redis://localhost:6381"

# --- Auth (hand-rolled, no Auth.js — see domain-implementation-plan.md §0.5.1.5) ---
# The app's real base URL. Its scheme (http:// vs https://) decides whether
# the session cookie gets the Secure flag and the __Host- prefix — NOT
# NODE_ENV, since a Solo/LAN install can legitimately run in production mode
# over plain HTTP. Leave unset (or http://) for local dev.
APP_URL="http://localhost:3000"

# --- First-run setup wizard ---
# Optional defense-in-depth: if set, /setup requires this value too.
SETUP_TOKEN=

# --- Payments (PRD §7 — gateway + manual) ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
